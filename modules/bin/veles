VELES_ROOT="${VELES_ROOT:-${NIX_HOUSING_REAL_HOME:-$HOME}/houses/shared/veles}"
WORK_ROOT="${VELES_WORK_ROOT:-$HOME/work}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/veles"
readonly VELES_ROOT WORK_ROOT STATE
shopt -s nullglob

usage() {
  cat <<'EOF'
veles — transmit change sets between nix houses using patches

  veles init             snapshot HEAD of the current repo as the project's latest init
  veles receive <name>   check out the latest init into ~/work/<name>
  veles update           merge the latest init into the current work dir
  veles deliver          emit a patch of all work dir changes since its init
  veles apply [patch]    apply a patch (default: newest for this repo)
  veles stage            copy each project's newest unhandled patch into host state
  veles accept           apply every staged patch into its init repo
  veles deny             mark every staged patch handled without applying
  veles list             show inits and patches
  veles prune [days]     drop patches older than days (14) and all but latest inits
EOF
}

die() {
  printf 'veles: %s\n' "$*" >&2
  exit 1
}

check_name() {
  case $1 in
    '' | .* | */*) die "invalid project name: $1" ;;
  esac
}

latest_rev() {
  readlink "$VELES_ROOT/inits/$1/latest" || die "no init for $1"
}

enter_top() {
  local top
  top=$(git rev-parse --show-toplevel) || die "not inside a git repo"
  cd "$top" || exit
}

enter_work() {
  enter_top
  git config veles.name >/dev/null || die "not a veles work dir"
}

tree_of() {
  local index
  index="$(git rev-parse --absolute-git-dir)/veles-index"
  rm -f "$index"
  GIT_INDEX_FILE=$index git --work-tree="$1" add --all --force
  GIT_INDEX_FILE=$index git write-tree
  rm -f "$index"
}

cmd_init() {
  local name rev dir stage origin
  enter_top
  name=$(basename "$PWD")
  rev=$(git rev-parse --short HEAD)
  dir="$VELES_ROOT/inits/$name"
  git diff --quiet HEAD || printf 'veles: uncommitted changes are not included\n' >&2
  if [ ! -d "$dir/$rev" ]; then
    mkdir -p "$dir"
    stage=$(mktemp -d "$dir/.$rev.XXXXXX")
    git archive HEAD | tar -x -C "$stage"
    mv "$stage" "$dir/$rev"
  fi
  ln -sfn "$rev" "$dir/latest"
  mkdir -p "$STATE/origins"
  origin=$(cat "$STATE/origins/$name" 2>/dev/null) || origin=$PWD
  [ "$origin" = "$PWD" ] || printf 'veles: %s now applies into %s, was %s\n' "$name" "$PWD" "$origin" >&2
  printf '%s\n' "$PWD" >"$STATE/origins/$name"
  printf 'inited %s@%s\n' "$name" "$rev"
}

cmd_receive() {
  local name=$1 rev dest base
  check_name "$name"
  rev=$(latest_rev "$name")
  dest="$WORK_ROOT/$name"
  [ ! -e "$dest" ] || die "$dest exists; run veles update inside it"
  git init --quiet "$dest"
  cd "$dest" || exit
  base=$(tree_of "$VELES_ROOT/inits/$name/$rev")
  git read-tree --reset -u "$base"
  git update-ref refs/veles/base "$base"
  git config veles.name "$name"
  git config veles.rev "$rev"
  printf 'received %s@%s -> %s\n' "$name" "$rev" "$dest"
}

cmd_update() {
  local name rev latest wip new out rc=0
  enter_work
  name=$(git config veles.name)
  rev=$(git config veles.rev)
  latest=$(latest_rev "$name")
  [ "$latest" != "$rev" ] || { printf 'already at %s\n' "$rev"; return; }
  git add --all
  wip=$(git write-tree)
  git update-ref refs/veles/wip "$wip"
  new=$(tree_of "$VELES_ROOT/inits/$name/$latest")
  out=$(git merge-tree --write-tree --name-only --no-messages \
    --merge-base=refs/veles/base "$wip" "$new") || rc=$?
  [ "$rc" -le 1 ] || die "merge failed"
  git read-tree --reset -u "${out%%$'\n'*}"
  git read-tree "$new"
  git update-ref refs/veles/base "$new"
  git config veles.rev "$latest"
  printf 'updated %s %s -> %s\n' "$name" "$rev" "$latest"
  [ "$rc" -eq 0 ] || die "conflicts in:
$(printf '%s\n' "$out" | tail -n +2 | sort -u)
pre-update state kept at refs/veles/wip"
}

cmd_deliver() {
  local name rev dir patch
  enter_work
  name=$(git config veles.name)
  rev=$(git config veles.rev)
  git ls-files --others --exclude-standard -z | xargs -0 -r git add --intent-to-add --
  ! git diff --quiet refs/veles/base || die "no changes to deliver"
  dir="$VELES_ROOT/patches/$name"
  patch="$dir/$(date +%Y%m%d-%H%M%S)-$rev.patch"
  mkdir -p "$dir"
  git diff --binary refs/veles/base >"$patch.part"
  mv "$patch.part" "$patch"
  git diff --stat refs/veles/base
  printf 'delivered %s\n' "$patch"
}

cmd_apply() {
  local patch=${1:-} name snapshot rev patches
  enter_top
  name=$(basename "$PWD")
  if [ -z "$patch" ]; then
    patches=("$VELES_ROOT/patches/$name"/*.patch)
    [ ${#patches[@]} -gt 0 ] || die "no patches for $name"
    patch=${patches[-1]}
  elif [ ! -f "$patch" ]; then
    patch="$VELES_ROOT/patches/$name/$patch"
  fi
  [ -f "$patch" ] || die "no such patch: $patch"
  snapshot="$(git rev-parse --absolute-git-dir)/veles-apply.patch"
  cp "$patch" "$snapshot"
  rev=$(basename "$patch" .patch)
  rev=${rev##*-}
  [ "$(git rev-parse --verify --quiet "$rev^{commit}")" = "$(git rev-parse HEAD)" ] \
    || printf 'veles: patch base %s != HEAD, 3-way merging\n' "$rev" >&2
  printf '%s\n' "$patch"
  sha256sum "$snapshot"
  git apply --stat --summary "$snapshot"
  git apply --3way "$snapshot"
  printf 'applied, uncommitted — review with git status && git diff HEAD\n'
}

newest_patch() {
  local dir="$VELES_ROOT/patches/$1" ps i p
  [ -L "$dir" ] && return 1
  ps=("$dir"/*.patch)
  for ((i = ${#ps[@]} - 1; i >= 0; i--)); do
    p=${ps[i]##*/}
    [[ $p =~ ^[0-9]{8}-[0-9]{6}-[0-9a-f]+\.patch$ && -f ${ps[i]} && ! -L ${ps[i]} ]] && { printf '%s\n' "$p"; return; }
  done
  return 1
}

staged_name() {
  local f=${1##*/}
  printf '%s\n' "${f%@*}"
}

cmd_stage() {
  local origin name p handled f
  mkdir -p "$STATE/staged"
  for origin in "$STATE/origins"/*; do
    name=${origin##*/}
    p=$(newest_patch "$name") || continue
    handled=$(cat "$STATE/handled/$name" 2>/dev/null) || handled=
    f="$STATE/staged/$name@$p"
    if [[ ! $p > $handled ]]; then
      rm -f "$STATE/staged/$name"@[0-9]*.patch
      continue
    fi
    if [ ! -f "$f" ]; then
      rm -f "$STATE/staged/$name"@[0-9]*.patch "$STATE/failed/$name"
      cp "$VELES_ROOT/patches/$name/$p" "$f.part"
      mv "$f.part" "$f"
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$(cat "$origin")" "$f" "$(cat "$STATE/failed/$name" 2>/dev/null)"
  done
}

handle() {
  mkdir -p "$STATE/handled"
  printf '%s\n' "${2##*@}" >"$STATE/handled/$1"
  rm -f "$2" "$STATE/failed/$1"
}

accept_one() (
  name=$1 f=$2
  fail() {
    mkdir -p "$STATE/failed"
    printf '%s\n' "$*" >"$STATE/failed/$name"
    exit 1
  }
  repo=$(cat "$STATE/origins/$name") || fail "no origin recorded"
  cd "$repo" || fail "$repo unreachable from veles-accept"
  [ -z "$(git status --porcelain)" ] || fail "$repo has uncommitted changes"
  git apply --3way "$f" || fail "conflicts in $repo; resolve, then deny to clear"
  handle "$name" "$f"
  printf 'applied %s -> %s\n' "${f##*@}" "$repo"
)

cmd_accept() {
  local f rc=0
  for f in "$STATE/staged"/*@*.patch; do
    accept_one "$(staged_name "$f")" "$f" || rc=1
  done
  return "$rc"
}

cmd_deny() {
  local f
  for f in "$STATE/staged"/*@*.patch; do
    handle "$(staged_name "$f")" "$f"
  done
}

cmd_list() {
  local dir rev
  printf 'inits:\n'
  for dir in "$VELES_ROOT/inits"/*/; do
    rev=$(readlink "$dir/latest") || rev='?'
    printf '  %s@%s\n' "$(basename "$dir")" "$rev"
  done
  printf 'patches:\n'
  find "$VELES_ROOT/patches" -name '*.patch' -printf '  %P\n' 2>/dev/null | sort
}

cmd_prune() {
  local days=${1:-14} dir latest
  case $days in '' | *[!0-9]*) die "days must be a number: $days" ;; esac
  find "$VELES_ROOT/patches" -name '*.patch' -mtime "+$days" -delete 2>/dev/null || true
  for dir in "$VELES_ROOT/inits"/*/; do
    latest=$(readlink "$dir/latest") || continue
    find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name "$latest" -exec rm -rf {} +
  done
  cmd_list
}

main() {
  case "${1:-}" in
    init) cmd_init ;;
    receive) [ $# -eq 2 ] || { usage >&2; exit 1; }; cmd_receive "$2" ;;
    update) cmd_update ;;
    deliver) cmd_deliver ;;
    apply) [ $# -le 2 ] || { usage >&2; exit 1; }; cmd_apply "${2:-}" ;;
    stage) cmd_stage ;;
    accept) cmd_accept ;;
    deny) cmd_deny ;;
    list) cmd_list ;;
    prune) cmd_prune "${2:-}" ;;
    -h | --help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
