vars: {
  d2-config: {
    layout-engine: elk # dagre
  }
  unifi: https://172.16.99.15:8443/
}

direction: down

classes: {
  # switch_l2: {
  #   shape: image
  #   icon: https://raw.githubusercontent.com/aci686/Network-Icons-SVG/refs/heads/master/generic-switch-l2-v1-colour.svg
  # }
  # switch_l3: {
  #   shape: image
  #   icon: https://raw.githubusercontent.com/aci686/Network-Icons-SVG/refs/heads/master/generic-switch-l3-colour.svg
  # }
  active_link: {
    style.animated: true
  }
  planned: {
    style.stroke-dash: 3
  }
}

cluster.label.near: outside-top-left
office.label.near: outside-top-left
home.label.near: outside-top-left
cluster.*.width: 140
office.*.width: 140

sspine: {
  # class: switch_l2
  link: ${unifi}
}

spine: {
  # class: switch_l3
  link: ${unifi}
}

mgsw: {
  # class: switch_l2
  link: ${unifi}
}

networks: {
  shape: sql_table
  label: Networks
  LAN: "Untagged / 172.16.0.0/22"
  CLUSTER: "VLAN 10 / 172.16.4.0/23"
  CLUSTER_STORAGE: "VLAN 15 / 172.16.15.0/24"
  STORAGE: "VLAN 20 / 172.16.20.0/24"
  LAB: "VLAN 80 / 172.16.80.0/24"
  OPS: "VLAN 95 / 172.16.95.0/24"
  MGMT: "VLAN 99 / 172.16.99.0/24"
  HOME: "VLAN 100 / 172.16.100.0/24"
  WORK: "VLAN 101 / 192.168.101.0/24"
  MX: "VLAN 110 / 172.16.110.0/24"
  GUEST: "VLAN 120 / 172.16.120.0/24"
  VPN_BRIDGE: "VLAN 140 / 172.16.140.0/24"
  IOT: "VLAN 200 / 172.16.200.0/24"
  WAN: "VLAN 3000 / 136.30.121.0/24"
  PFSYNC: "VLAN 4000 / 10.255.254.0/29"
  LAYER3: "VLAN 4040 / 10.255.253.0/24"
  VPN: "wg0 / 172.17.0.0/24"
  FAMILY_VPN: "wg1 / 172.17.100.0/24"
}

networks -> ISP: {style.opacity: 0}

ISP -- edgesw: Uplink, Trunk (Untagged) {
  source-arrowhead.label: Uplink
  target-arrowhead.label: 1
  class: active_link
}

edgesw -- cluster.n1: WAN, Access (VLAN 3000) {
  source-arrowhead.label: 2
  target-arrowhead.label: 0/3
  class: active_link
}

edgesw -- cluster.n2: WAN, Access (VLAN 3000) {
  source-arrowhead.label: 3
  target-arrowhead.label: 0/3
  class: active_link
}

sspine -- cluster.n1: LAN (bond0), Trunk (Untagged) {
  source-arrowhead.label: 1
  target-arrowhead.label: 0/1
  class: active_link
}

sspine -- cluster.n1: LAN (bond0), Trunk (Untagged) {
  source-arrowhead.label: 2
  target-arrowhead.label: 0/2
  class: active_link
}

sspine -- cluster.n2: LAN (bond0), Trunk (Untagged) {
  source-arrowhead.label: 3
  target-arrowhead.label: 0/1
  class: active_link
}

sspine -- cluster.n2: LAN (bond0), Trunk (Untagged) {
  source-arrowhead.label: 4
  target-arrowhead.label: 0/2
  class: active_link
}

sspine -- cluster.m1: Storage (bond0), Trunk {
  source-arrowhead.label: 5
  target-arrowhead.label: 1/1
  class: active_link
}

sspine -- cluster.m1: Storage (bond0), Trunk {
  source-arrowhead.label: 6
  target-arrowhead.label: 1/2
  class: active_link
}

sspine -- spine: {
  source-arrowhead.label: 7
  target-arrowhead.label: 9
  class: active_link
}

# two crosslinks or link to another switch in the living room
sspine -- spine: {
  source-arrowhead.label: 8
  target-arrowhead.label: 8
  class: planned
}

spine -- mgsw: {
  source-arrowhead.label: 8
  target-arrowhead.label: 8
  class: active_link
}

spine -- office.liana: Ops, Access (VLAN 95) {
  source-arrowhead.label: 1
  target-arrowhead.label: 2.5GbE
  class: active_link
}

spine -- home.access_point: LAN, Trunk (Untagged) {
  source-arrowhead.label: 2
  target-arrowhead.label: 2.5GbE
  class: active_link
}

# Current
# spine -- cluster.m1: {
#   source-arrowhead.label: 3
#   target-arrowhead.label: 0/1
#   class: active_link
# }

spine -- office.liana: Work, Access (VLAN 101) {
  source-arrowhead.label: 4
  target-arrowhead.label: 2.5GbE
  class: active_link
}

spine -- office.maxine: Ops, Access (VLAN 95) {
  source-arrowhead.label: 5
  target-arrowhead.label: 2.5GbE
  class: active_link
}

spine -- home.catbox: Home, Access (VLAN 100) {
  source-arrowhead.label: 6
  target-arrowhead.label: 2.5GbE
  class: active_link
}

spine -- cluster.n3: MGMT, Access (VLAN 99) {
  source-arrowhead.label: 7
  target-arrowhead.label: 0/1
  class: active_link
}

mgsw -- oob: MGMT, Access (VLAN 99) {
  source-arrowhead.label: 2
  target-arrowhead.label: eth
  class: active_link
}

cluster.m1 -- mgsw: Access (VLAN 99) {
  source-arrowhead.label: 0/1
  target-arrowhead.label: 4
}

cluster.n1 -- mgsw: Access (VLAN 99) {
  source-arrowhead.label: 0/4
  target-arrowhead.label: 5
}

cluster.n1 -- cluster.n2: PFSYNC (VLAN 4000) {
  source-arrowhead.label: TB2
  target-arrowhead.label: TB2
}

cluster.n2 -- mgsw: Access (VLAN 99) {
  source-arrowhead.label: 0/4
  target-arrowhead.label: 6
}

cluster.n3 -- mgsw: Access (VLAN 99) {
  source-arrowhead.label: USB
  target-arrowhead.label: 7
}
